# SMTP (your mail server)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM="7 Factors Contact <noreply@7factors.co>"

# Where to send contact form submissions
CONTACT_TO=info@7factors.co

# Optional: port for this API (default 3001)
PORT=3001
